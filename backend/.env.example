# Backend runtime environment variables (copy to .env for local use)

# Path to trained Keras model file
MODEL_PATH=models/kiosk_face_model_eff.keras

# CORS origins as comma-separated values
# Examples:
# CORS_ALLOW_ORIGINS=http://localhost:5173
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com
CORS_ALLOW_ORIGINS=*

# Face crop and model input tuning
FACE_PADDING=30
IMAGE_WIDTH=224
IMAGE_HEIGHT=224
MIN_DETECTION_CONFIDENCE=0.7
PREDICTION_THRESHOLD=0.5
